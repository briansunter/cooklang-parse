/**
 * Cooklang Grammar for Ohm
 * Based on the official Cooklang specification at https://cooklang.org/docs/spec/
 */

Cooklang {
  // Main recipe structure
  Recipe
    = (MetadataDirective | blankLine)* RecipeItem*

  // Recipe items can be interleaved
  RecipeItem
    = Section | MetadataDirective | Note | CommentLine | blankLine | spaceOnly | Step

  // Named section: one or more leading '=', a name (no '='), optional trailing
  // '=' run, then only whitespace/comments until end of line. Matches
  // cooklang-rs `section = Eq+ (section_name Eq*)` where the line must end.
  Section
    = "="+ sectionName "="* hspace* &(newline | end)

  sectionName
    = (~"=" ~newline any)*

  // Recipe step - paragraphs separated by blank lines
  Step
    = StepLine+

  StepLine
    = ~(hspace* "--") ~(hspace* newline) ~Section ~MetadataDirective StepItem+ InlineComment? "\n"?

  // Items that can appear in a step. markerChar is a recovery fallback: a
  // component marker (@ # ~) that did not form a valid component is emitted as
  // literal text, mirroring cooklang-rs which backtracks and treats it as text.
  StepItem
    = Ingredient | Cookware | Timer | Text | markerChar

  markerChar
    = "@" | "#" | "~"

  // Text without special Cooklang syntax
  Text
    = (~("\n" | "\r\n" | "\r" | "@" &ingredientStartChar | "#" &cookwareStartChar | "~" &wordChar | "~" &"{" | "--") any)+

  ingredientStartChar
    = wordChar | "@" | "&" | "?" | "+" | "-"

  cookwareStartChar
    = wordChar | "&" | "?" | "+" | "-"

  // Ingredient: @name{quantity%unit} or @multi word name{}
  Ingredient
    = "@" ingredientModifiers ingredientWord (hspace+ ingredientWord)+ ingredientAmount ingredientNote?  -- multi
    | "@" ingredientModifiers ingredientWord ingredientAmount? ingredientNote?                           -- single

  ingredientNote
    = "(" (~")" ~newline any)* ")"

  ingredientModifiers
    = ("@" | "&" | "?" | "+" | "-")*

  ingredientWord
    = componentWordChar+

  ingredientAmount
    = "{" amountFixed? amountQuantity "%" amountUnit "}"  -- withUnit
    | "{" hspace* amountFixed? hspace* "}"                 -- empty
    | "{" amountFixed? amountQuantity "}"                   -- quantityOnly

  // Cookware: #name or #multi word{}
  Cookware
    = "#" cookwareModifiers cookwareWord (hspace+ cookwareWord)+ cookwareAmount cookwareNote?   -- multi
    | "#" cookwareModifiers cookwareWord cookwareAmount? cookwareNote?                         -- single

  cookwareNote
    = "(" (~")" ~newline any)* ")"

  cookwareModifiers
    = ("&" | "?" | "+" | "-")*

  cookwareWord
    = componentWordChar+

  // Cookware amounts use the same quantity/unit parsing as ingredients
  // (cooklang-rs runs the same parse_quantity for all components).
  cookwareAmount
    = "{" amountFixed? amountQuantity "%" amountUnit "}"  -- withUnit
    | "{" hspace* amountFixed? hspace* "}"                -- empty
    | "{" amountFixed? amountQuantity "}"                  -- quantityOnly

  // Timer: ~{quantity%unit} or ~name{quantity%unit}
  Timer
    = "~" timerName? "{" amountQuantity "%" amountUnit "}"  -- withUnit
    | "~" timerName? "{" amountQuantity "}"                  -- quantityOnly
    | "~" timerName? "{" hspace* "}"                          -- empty
    | "~" timerName                                           -- word

  timerName
    = word+

  // Shared amount sub-rules for ingredients and timers
  amountFixed
    = hspace* "=" hspace*

  amountQuantity
    = (~"%" ~"}" any)+

  amountUnit
    = (~"}" any)*

  // Text block (starts with >). Like cooklang-rs, a text block continues
  // consuming following non-blank lines (until a blank line, section, or
  // metadata directive) and treats them all as literal text — components inside
  // a text block are not parsed.
  Note
    = NoteLine NoteContLine*

  // A leading ">>" is a metadata directive, never a text block. When it is not
  // a valid directive (no colon) it falls through to a step, matching cooklang-rs.
  NoteLine
    = ">" ~">" hspace* noteText? Newline?

  NoteContLine
    = ~blankLine ~Section ~MetadataDirective NoteContBody Newline?

  NoteContBody
    = ">" hspace* noteText?  -- marked
    | noteText               -- plain

  noteText
    = (~"\n" ~"\r" any)+

  // Metadata directive: >> key: value
  MetadataDirective
    = hspace* ">>" directiveBody Newline?

  directiveBody
    = hspace* directiveKey hspace* ":" directiveValue

  directiveKey
    = (~":" ~newline any)+

  directiveValue
    = (~newline any)*

  // Inline comment: -- comment (no space required, matching cooklang-rs lexer)
  InlineComment
    = "--" (~Newline any)*

  // Full-line comments
  CommentLine
    = hspace* InlineComment Newline?

  // Component name word char - wordChar plus | for alias syntax
  componentWordChar
    = wordChar | "|"

  // Basic tokens
  word
    = wordChar+

  wordChar
    = letter | digit | "_" | "-" | emoji | otherWordChar

  emoji
    = "\u{1F600}".."\u{1F64F}"
    | "\u{1F300}".."\u{1F5FF}"
    | "\u{1F680}".."\u{1F6FF}"
    | "\u{2600}".."\u{26FF}"
    | "\u{2700}".."\u{27BF}"
    | "\u{1F900}".."\u{1F9FF}"
    | "\u{1FA70}".."\u{1FAFF}"

  otherWordChar
    = "\u00C0".."\u00FF"
    | "\u0100".."\u017F"
    | "\u0400".."\u04FF"

  newline
    = "\n" | "\r\n" | "\r"

  Newline
    = newline

  blankLine
    = hspace* newline

  spaceOnly
    = hspace+ &end

  hspace
    = " " | "\t"

  // Keep Ohm's implicit skipping from crossing lines.
  space := "\t"
}
